# envoix generated read contract — the single source every generated read
# binding (Rust/Dart/Kotlin/Swift) derives from. The identifier catalog
# extracts the schema id from the `id` key; regenerate artifacts with
# `ENVOIX_BINDINGS_REGEN=1 cargo test -p envoix-bindings generated_artifacts`.
#
# Scalar vocabulary (closed — the parser rejects anything else):
#   u16 / u32 / u63   bounded unsigned integers (u63 fits every signed 64-bit)
#   hex16/hex32/hex64 fixed-length lowercase hex identifiers/fingerprints
#   hexv(N)           even-length lowercase hex, at most N characters
#   str(N)            UTF-8 text of at most N bytes
#   ascii(N)          printable ASCII of at most N bytes
#   option(T)         nullable field (the key is always present)
#   list(T, N)        at most N elements
# There is deliberately no bytes/blob type and no handle/path/URI type, so bulk
# payload bytes and OS handles cannot be represented in a read frame.

id = "envoix/binding/read/9"
root = "ReadFrame"
# Only the host originates read frames, so the native artifacts are decode-only:
# a frontend cannot fabricate an observation.
direction = "host_to_frontend"

[limits]
max_frame_bytes = 1048576

# ---- closed vocabularies mirrored from L0/L3/L4 public types ----

[[decl]]
kind = "enum"
name = "DirectionView"
variants = ["send", "receive"]

[[decl]]
kind = "enum"
name = "PhaseView"
variants = [
  "preparing",
  "pairing",
  "authenticating",
  "transferring",
  "confirming",
  "publishing",
  "restoring",
]

[[decl]]
kind = "enum"
name = "OutcomeCodeView"
variants = [
  "completed",
  "cancelled",
  "paused",
  "peer_lost",
  "timeout",
  "unauthenticated",
  "version_mismatch",
  "storage_fault",
  "publish_failed",
  "source_unreadable",
  "network_unreachable",
  "internal",
]

[[decl]]
kind = "enum"
name = "RetryabilityView"
variants = ["retryable", "terminal", "needs_user"]

[[decl]]
kind = "enum"
name = "RecoveryView"
variants = ["re_pick_source", "retry_later", "reconnect_peer"]

[[decl]]
kind = "enum"
name = "PauseOriginView"
variants = ["local", "peer", "lost"]

[[decl]]
kind = "enum"
name = "WorkerKindView"
variants = ["attempt", "staging"]

[[decl]]
kind = "enum"
name = "RetirementIntentView"
variants = ["pause", "cancel", "finalize"]

[[decl]]
kind = "enum"
name = "DutyKindView"
variants = [
  "source_handle",
  "grant",
  "staging",
  "publication",
  "courier",
  "foreground",
  "notification",
  "lock",
  "open_share",
]

[[decl]]
kind = "enum"
name = "CapabilityActionView"
# `acquire_source` is the HANDLE acquisition — take hold of the document that
# was already chosen — and it is issued when an offer is accepted. It was named
# `select_source` and issued at creation, which asked the platform to bind a
# document nobody had picked yet; the adapter claimed from an empty registry and
# answered `source_unreadable` every time. Opening the picker is not a duty at
# all: it is the `pick_source` card action.
variants = ["post_receipt", "acquire_source"]

# Which commands the authority will currently admit for a card. This is the
# product reducer's own `TransferRecord::allowed_commands`, PUBLISHED rather
# than re-derived: a frontend that computed legality from state would be owning
# transfer truth (R0). The variants mirror schema/command.schema's `CommandView`
# one for one, which `the_read_contract_publishes_every_command_a_frontend_can_send`
# pins against both schema files.
[[decl]]
kind = "enum"
name = "CommandKindView"
variants = ["pause", "cancel", "resume", "remove", "re_pick_source"]

[[decl]]
kind = "enum"
name = "RedactedIdKindView"
variants = ["record", "transfer", "artifact", "request"]

[[decl]]
kind = "enum"
name = "LosslessKindView"
variants = ["terminal", "capability_duty"]

[[decl]]
kind = "enum"
name = "SubscribeRejectionView"
variants = ["unknown_card", "runtime_stopped", "epoch_exhausted"]

# ---- typed outcome (display is the bounded L0 safe-display projection) ----

[[decl]]
kind = "struct"
name = "OutcomeView"
fields = [
  { name = "code", type = "OutcomeCodeView" },
  { name = "phase", type = "PhaseView" },
  { name = "retry", type = "RetryabilityView" },
  { name = "recovery", type = "option(RecoveryView)" },
  { name = "display", type = "str(160)" },
]

# ---- card state, quiescence, identity ----

[[decl]]
kind = "struct"
name = "PausedView"
fields = [{ name = "origin", type = "PauseOriginView" }]

[[decl]]
kind = "union"
name = "ProductStateView"
variants = [
  { name = "preparing" },
  { name = "waiting" },
  { name = "connecting" },
  { name = "verifying" },
  { name = "transferring" },
  { name = "confirming" },
  { name = "paused", payload = "PausedView" },
  { name = "unconfirmed" },
  { name = "completed" },
  { name = "failed" },
  { name = "cancelled" },
]

[[decl]]
kind = "struct"
name = "RunningView"
fields = [{ name = "worker", type = "WorkerKindView" }]

[[decl]]
kind = "struct"
name = "RetiringView"
fields = [
  { name = "worker", type = "WorkerKindView" },
  { name = "intent", type = "RetirementIntentView" },
]

[[decl]]
kind = "union"
name = "QuiescenceView"
variants = [
  { name = "running", payload = "RunningView" },
  { name = "retiring", payload = "RetiringView" },
  { name = "quiescent" },
]

[[decl]]
kind = "struct"
name = "IdentityView"
fields = [
  { name = "card", type = "hex16" },
  { name = "transfer", type = "hex32" },
  { name = "artifact", type = "hex32" },
]

# The rendezvous channel the card was frozen to at creation, as the authority
# holds it: the room code the user reads out and the canonical link the invite
# grammar (`envoix-invite`, C4) encodes for it. A frontend renders these; it
# never builds, parses or validates an invite (R0 `XI02`/`XI03`).
#
# Both bounds are the grammar's own published maxima rather than numbers
# invented here about its data: 64 is `MAX_ROOM_CODE_LENGTH` and 5481 is
# `MAX_INVITE_LINK_LENGTH`, the longest text `encode_deep_link` can produce.
# `generated_read_schema_roundtrip_and_containment` fails if either drifts from
# the constant it derives from, because the schema language cannot name a Rust
# const. Sized this way, an invite the authority holds always fits, so the link
# is never truncated and never silently withheld.
#
# It stays optional for the one reason left: a record whose stored fields no
# longer spell an invite the grammar can encode has no link to publish.
# One invite as the square a camera reads: `width` modules per side, and the
# modules themselves row-major, one BIT each, packed most-significant-bit first
# and rendered as lowercase hex.
#
# Published as DATA rather than as an image, and published at all rather than
# left to each frontend, for the same reason the link is: the invite grammar in
# Rust owns what the square says, so one encoder serves Dart, Kotlin, Swift and
# any CLI instead of four encoders drifting apart — and no frontend needs a QR
# library to show a code. What remains a frontend's own is drawing: scale,
# quiet zone, colour and theme are decisions this contract deliberately does
# not make.
#
# `hexv(7834)` is version 40's worst case stated exactly: 177 modules a side is
# 31329 bits, which is 3917 bytes, which is 7834 hex characters. A square that
# does not fit is not truncated — it is absent, which is the frontier below.
[[decl]]
kind = "struct"
name = "QrView"
fields = [
  { name = "width", type = "u16" },
  # The SAME secret the code and the link are, in a third spelling. A QR is a
  # rendering of the pairing password, and a bitmap of it is no more secret
  # than the base64 the link carries; sealing two spellings and leaving the
  # third plain would let one log line draw the password.
  { name = "modules", type = "hexv(7834)", secret = true },
]

[[decl]]
kind = "struct"
name = "InviteView"
fields = [
  # The code is the SPAKE2 password. Every generated language wraps it in a
  # redacting scalar; displaying it requires an explicit expose boundary.
  { name = "code", type = "str(64)", secret = true },
  # Stable BLAKE3 digest prefix for shipped instrumentation. It proves which
  # rendered code was present without placing the password in a release log.
  { name = "code_fingerprint", type = "hex16" },
  # The link is the SAME secret in another spelling: the code lives inside its
  # base64, and base64 is not secrecy. Sealing the code and leaving the link
  # plain would let one log line spell the password anyway.
  { name = "link", type = "option(str(5481))", secret = true },
  # Absent when this invite has no square. Two causes share the answer and both
  # are honest: the stored fields no longer spell an invite, or they spell one
  # past the QR frontier — our grammar reaches 5481 bytes and QR's binary mode
  # stops around 2.3 kB, so an invite too long to draw is a REAL state, not an
  # error. A frontend renders that absence as an answer ("too long to show as a
  # code — share the link instead") rather than as an empty square.
  { name = "qr", type = "option(QrView)" },
]


# ---- where a card's send source is ----
#
# Record v5's `SourceLifecycle`, published as itself. It replaces the top-level
# `offered_name`/`total` this contract used to carry, and that is the point: a
# card that has not been given a document had NO name and NO size, so those
# fields published an invented empty string and a zero that reads as a real
# length. A frontend then had to guess which zero meant "empty file" and which
# meant "nothing chosen yet". Here the difference is a variant.
#
# It also removes the last reason a frontend would infer source need from
# direction, product state, phase or failure text. The lifecycle says what is
# true, and `allowed_actions` says what may be done about it.

[[decl]]
kind = "enum"
name = "RoomParticipationView"
variants = ["minted", "joined"]

# Which acquisition a picked document belongs to. All three fields, always: a
# value that matches the card but not the generation, or the generation but not
# the request, is a DIFFERENT acquisition and answering it would bind a document
# to a request it was never chosen for.
[[decl]]
kind = "struct"
name = "SourceAcquisitionKeyView"
fields = [
  { name = "card", type = "hex16" },
  { name = "generation", type = "u32" },
  { name = "request", type = "hex32" },
]

# Why the authority is asking. Carried so a frontend can say something true
# without inferring it, and so a repeat is distinguishable from a first ask.
# `staging_failed` is deliberately apart from the acquisition failures: it says
# the platform DID hold the document and reading it through failed, which is a
# different sentence to show a user.
[[decl]]
kind = "enum"
name = "SourcePromptReasonView"
variants = [
  "initial",
  "unreadable",
  "permission_lost",
  "storage_fault",
  "staging_failed",
  "internal",
]

# A document the user chose, as the authority normalized it. `reported_size` is
# what the PROVIDER claimed and is advisory only — it is optional because a
# provider may not know, and `0` is a real empty-file report that stays distinct
# from absent. It never becomes the transfer's total.
[[decl]]
kind = "struct"
name = "AcceptedSourceOfferView"
fields = [
  { name = "acquisition", type = "SourceAcquisitionKeyView" },
  { name = "display_name", type = "str(255)" },
  { name = "reported_size", type = "option(u63)" },
]

# What a card is transferring, once anything knows: a sender learns it from
# staging, which counted the bytes; a receiver from the peer's header.
[[decl]]
kind = "struct"
name = "TransferContentView"
fields = [
  { name = "offered_name", type = "str(255)" },
  { name = "total", type = "u63" },
]

# A receiver. It has no source and can never acquire one, and `peer_content` is
# absent until the peer's header is admitted — honest, because a card joined
# from an invite knows nothing about the file until the sender says so.
[[decl]]
kind = "struct"
name = "SourceNotRequiredView"
fields = [
  { name = "peer_content", type = "option(TransferContentView)" },
]

# The authority is asking, and this is the exact key an offer must name.
[[decl]]
kind = "struct"
name = "SourceSelectableView"
fields = [
  { name = "acquisition", type = "SourceAcquisitionKeyView" },
  { name = "reason", type = "SourcePromptReasonView" },
]

# This generation accepted a document and then lost it. It publishes NO
# acquisition key, because it can accept no offer: only `re_pick_source`
# advances the generation and mints a key that can. The offer it did accept is
# retained so a frontend retrying across a process death is told the truth about
# its own payload rather than "stale".
[[decl]]
kind = "struct"
name = "SourceRePickRequiredView"
fields = [
  { name = "reason", type = "SourcePromptReasonView" },
  { name = "previous_offer", type = "AcceptedSourceOfferView" },
]

[[decl]]
kind = "union"
name = "SourceSelectionGateView"
variants = [
  { name = "selectable", payload = "SourceSelectableView" },
  { name = "re_pick_required", payload = "SourceRePickRequiredView" },
]

[[decl]]
kind = "struct"
name = "SourceAwaitingSelectionView"
fields = [
  { name = "selection", type = "SourceSelectionGateView" },
]

# The content is established and the source can be sent. `content` is
# authoritative — staging counted it — unlike the offer's `reported_size`
# beside it, which is still only what the provider claimed. Both are published
# because a frontend showing "4.0 MB" should be able to say which number that
# is. The staging digest is NOT here: it is the sender's own verification
# evidence and no frontend has asked for it.
[[decl]]
kind = "struct"
name = "SourceReadyView"
fields = [
  { name = "offer", type = "AcceptedSourceOfferView" },
  { name = "content", type = "TransferContentView" },
]

# `acquiring` and `staging` carry the accepted offer and nothing more, which is
# exactly what is true of them: the platform is being asked to hold a document,
# or is being read through, and the only facts that exist are the provider's
# normalized name and its advisory size.
[[decl]]
kind = "union"
name = "SourceLifecycleView"
variants = [
  { name = "not_required", payload = "SourceNotRequiredView" },
  { name = "awaiting_selection", payload = "SourceAwaitingSelectionView" },
  { name = "acquiring", payload = "AcceptedSourceOfferView" },
  { name = "staging", payload = "AcceptedSourceOfferView" },
  { name = "ready", payload = "SourceReadyView" },
]

# Open a document picker for THIS acquisition.
#
# Not a command and not a duty. A command mutates a card through the authority;
# a duty is work the authority commissions from the platform and ledgers the
# answer to. This is neither: it is the frontend and its own platform adapter
# exchanging a document, and cancelling it produces no result the authority
# needs to hear about. The key travels with the action so the offer that comes
# back can only name the acquisition that was asked for.
[[decl]]
kind = "struct"
name = "PickSourceActionView"
fields = [
  { name = "acquisition", type = "SourceAcquisitionKeyView" },
]

# What a frontend may do to this card right now, whether or not it goes through
# the command lane. Published rather than derived, for the same reason
# `allowed_actions` always was: a frontend that computed legality from state
# would be owning transfer truth (R0).
[[decl]]
kind = "union"
name = "CardActionView"
variants = [
  { name = "command", payload = "CommandKindView" },
  { name = "pick_source", payload = "PickSourceActionView" },
]

[[decl]]
kind = "struct"
name = "CardView"
fields = [
  { name = "identity", type = "IdentityView" },
  { name = "participation", type = "RoomParticipationView" },
  { name = "direction", type = "DirectionView" },
  { name = "source", type = "SourceLifecycleView" },
  { name = "state", type = "ProductStateView" },
  { name = "quiescence", type = "QuiescenceView" },
  { name = "generation", type = "u32" },
  { name = "phase", type = "PhaseView" },
  { name = "bytes", type = "u63" },
  { name = "bytes_resumed", type = "u63" },
  { name = "outcome", type = "option(OutcomeView)" },
  # Six: the five commands, plus `pick_source`. They are never all offered at
  # once — a card awaiting a document offers no Pause — but the bound is the
  # vocabulary, not a prediction about which of it is live.
  { name = "allowed_actions", type = "list(CardActionView, 6)" },
  # Only a MINTED card publishes an invite. A joined card adopted the secret it
  # was given, and republishing it as though it minted the room is how a joiner
  # would hand out a password it does not own.
  { name = "invite", type = "option(InviteView)" },
]

# ---- capability duties ----

[[decl]]
kind = "struct"
name = "DutyProvenanceView"
fields = [
  { name = "card", type = "hex16" },
  { name = "generation", type = "u32" },
  { name = "request", type = "hex32" },
]

[[decl]]
kind = "struct"
name = "DutyView"
fields = [
  { name = "provenance", type = "DutyProvenanceView" },
  { name = "kind", type = "DutyKindView" },
]

[[decl]]
kind = "struct"
name = "DutyFrameView"
fields = [
  { name = "duty", type = "DutyView" },
  { name = "action", type = "CapabilityActionView" },
]

# ---- the per-epoch card stream ----

[[decl]]
kind = "union"
name = "CardUpdateKindView"
variants = [
  { name = "snapshot", payload = "CardView" },
  { name = "progress", payload = "CardView" },
  { name = "state", payload = "CardView" },
  { name = "terminal", payload = "CardView" },
  { name = "capability_duty", payload = "DutyFrameView" },
]

[[decl]]
kind = "struct"
name = "CardUpdateView"
fields = [
  { name = "epoch", type = "u63" },
  { name = "card", type = "hex16" },
  { name = "kind", type = "CardUpdateKindView" },
]

[[decl]]
kind = "struct"
name = "LagView"
fields = [
  { name = "epoch", type = "u63" },
  { name = "card", type = "hex16" },
  { name = "missed", type = "LosslessKindView" },
]

[[decl]]
kind = "struct"
name = "ClosedView"
fields = [
  { name = "epoch", type = "u63" },
  { name = "card", type = "hex16" },
]

[[decl]]
kind = "struct"
name = "SubscribeRejectedView"
fields = [
  { name = "card", type = "hex16" },
  { name = "reason", type = "SubscribeRejectionView" },
]

# ---- the redacted evidence timeline ----

[[decl]]
kind = "struct"
name = "SessionKeyView"
fields = [
  { name = "card", type = "hex16" },
  { name = "generation", type = "u32" },
]

[[decl]]
kind = "struct"
name = "EvidenceProgressView"
fields = [
  { name = "transferred", type = "u63" },
  { name = "total", type = "u63" },
]

[[decl]]
kind = "struct"
name = "RedactedIdView"
fields = [{ name = "kind", type = "RedactedIdKindView" }]

[[decl]]
kind = "union"
name = "EvidenceValueView"
variants = [
  { name = "phase", payload = "PhaseView" },
  { name = "progress", payload = "EvidenceProgressView" },
  { name = "outcome", payload = "OutcomeView" },
  { name = "identifier", payload = "RedactedIdView" },
]

[[decl]]
kind = "struct"
name = "DegradedView"
fields = [{ name = "dropped_events", type = "u63" }]

[[decl]]
kind = "union"
name = "DiagnosticsStatusView"
variants = [
  { name = "complete" },
  { name = "degraded", payload = "DegradedView" },
]

[[decl]]
kind = "struct"
name = "TimelineEntryView"
fields = [
  { name = "sequence", type = "u63" },
  { name = "value", type = "EvidenceValueView" },
]

[[decl]]
kind = "struct"
name = "EvidenceTimelineView"
fields = [
  { name = "session", type = "SessionKeyView" },
  { name = "status", type = "DiagnosticsStatusView" },
  { name = "entries", type = "list(TimelineEntryView, 1024)" },
]

# ---- descriptive build/trust metadata ----

[[decl]]
kind = "struct"
name = "ProtocolManifestView"
fields = [
  { name = "set_id", type = "ascii(64)" },
  { name = "data_alpn", type = "hexv(64)" },
  { name = "data_magic", type = "hexv(32)" },
  { name = "data_wire_version", type = "u16" },
]

# The complete ABI/schema identity. The two binding schema ids are composed
# here rather than in the L4 manifest: L5 depends on L4, so only this layer can
# see both the L4 identities and the generated contract ids at once.
[[decl]]
kind = "struct"
name = "AbiSchemaManifestView"
fields = [
  { name = "read_binding_schema_id", type = "ascii(64)" },
  { name = "command_binding_schema_id", type = "ascii(64)" },
  # The capability contract a frontend and its platform adapter speak. It is
  # declared here for the reason the other two are: a release states every
  # contract it speaks, and this one is spoken between the Dart in libapp.so and
  # the Kotlin in classes.dex — two halves of one artifact that must agree.
  { name = "capability_binding_schema_id", type = "ascii(64)" },
  { name = "evidence_rust_abi_id", type = "ascii(64)" },
  { name = "evidence_timeline_schema_id", type = "ascii(64)" },
  { name = "mailbox_receipt_schema_id", type = "ascii(64)" },
  { name = "operation_envelope_schema_id", type = "ascii(64)" },
]

# Which deployment this build is FOR. It is part of the build identity, not a
# setting: an app is compiled for one environment, freezes that environment's
# broker and relay into every invite it mints, and the release gate's
# destination rule judges the environment named here.
[[decl]]
kind = "struct"
name = "DeploymentManifestView"
fields = [
  { name = "environment", type = "ascii(32)" },
  # `<node_id>@<host>:<port>` and `<scheme>://<host>:<port>`, both spelled by
  # the catalogue's own derivation templates rather than by this contract. The
  # bounds are the INVITE grammar's published broker/relay maxima, because these
  # two strings become exactly those two fields in every invite this build
  # mints: an endpoint this contract could carry but an invite could not would
  # be a number invented about somebody else's data.
  { name = "rendezvous_endpoint", type = "ascii(1024)" },
  { name = "relay_url", type = "ascii(2048)" },
]

[[decl]]
kind = "struct"
name = "BuildManifestView"
fields = [
  { name = "package_version", type = "ascii(32)" },
  { name = "protocol", type = "ProtocolManifestView" },
  { name = "abi_schema", type = "AbiSchemaManifestView" },
  { name = "deployment", type = "DeploymentManifestView" },
]

# ---- the frame envelope ----

[[decl]]
kind = "union"
name = "ReadBody"
variants = [
  { name = "card_update", payload = "CardUpdateView" },
  { name = "lag", payload = "LagView" },
  { name = "closed", payload = "ClosedView" },
  { name = "subscribe_rejected", payload = "SubscribeRejectedView" },
  { name = "evidence", payload = "EvidenceTimelineView" },
  { name = "build_manifest", payload = "BuildManifestView" },
]

[[decl]]
kind = "struct"
name = "ReadFrame"
fields = [
  { name = "schema", type = "ascii(64)" },
  { name = "body", type = "ReadBody" },
]
