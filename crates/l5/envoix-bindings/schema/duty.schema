# envoix generated duty contract — the single source every generated duty
# binding (Rust/Dart/Kotlin/Swift) derives from. The identifier catalog extracts
# the schema id from the `id` key; regenerate artifacts with
# `ENVOIX_BINDINGS_REGEN=1 cargo test -p envoix-bindings generated_artifacts`.
#
# WHAT THIS IS, and why it is a fourth contract rather than part of `capability`.
#
# A duty is committed, card-scoped platform work: the Rust authority issues it,
# a platform executor performs it, and the answer is admitted exactly once by
# the C6 `DutyLedger`. Its provenance names a card, an attempt generation and a
# request, and the outcome it returns is L0's TRANSFER vocabulary.
#
# `capability.schema` is a different exchange between different peers. Its two
# peers are a frontend and its own platform adapter, it is deliberately
# card-LESS (a scan happens before any card exists), and the Rust authority is
# explicitly not a peer. Folding duties into it would be worse than untidy:
# capability's marked arm makes every declaration under it native-encodable, so
# a duty ORDER would become constructible by a native caller. Authority orders
# must not be forgeable by the side that executes them.
#
# WHY THIS CONTRACT EXISTS AT ALL. Until now this lane was two hand-written
# codecs — `serde_json` in `envoix-platform-android::duty` and `org.json`
# `opt*` calls in `DutyExecutor.kt` — that independently decided the JSON
# shape. They disagreed: Rust encodes `notice` as a string and Kotlin asked for
# an object, so every notification silently collapsed to generic text. The gate
# that was supposed to catch this compared `when` labels in Kotlin SOURCE TEXT
# and stayed green throughout. A contract removes the decision from both sides.
#
# DIRECTION. Rust encodes `order`; the native platform executor encodes
# `report`. The generator's `originator = "frontend"` spelling means "the
# non-Rust native encoder"; on this contract that peer is the Kotlin service on
# Android and would be Swift on Apple, not the UI frontend. The name is the
# generator's, and it is worth renaming to "native" one day across all schemas
# at once — but only the reachability it controls matters here, and that is
# exactly right: `DutyReportView` is reachable from the marked arm and
# `DutyOrderView`/`WorkView` are not, so no native artifact gets a way to build
# an order.
#
# CONTAINMENT. The scalar vocabulary has no bytes/blob type and no handle, path
# or URI type. `staged` is bounded opaque text naming an app-private RELATIVE
# artifact, never an absolute OS path; its relative-path invariants live in the
# authority's projection and the executor's own containment check, because a
# path grammar in the schema language would weaken that rule for every other
# contract. Artifact bytes and source handles cannot be spelled here at all —
# which is why a duty report can carry an outcome and never a file.

id = "envoix/binding/duty/3"
root = "DutyFrame"
direction = "bidirectional"

[limits]
# Bounds the ENCODED frame including escaping, so individually in-bound text can
# still add up to a refusal — an honest `frame_too_large`, and what keeps a
# trusted control lane from quietly becoming a bulk-data lane.
#
# DERIVED from the largest thing this lane must carry, which is one answer per
# item of a selection. An offer may name 1024 documents (`Selection::MAX_ITEMS`,
# and `list(OfferedItemView, 1024)` in schema/command.schema), and this contract
# answers about every one of them, so it must hold 1024 `AcquiredItemView`s. At
# their longest — `{"item":1023,"retention":"persisted","seekability":
# "sequential_only"}` — that is a little over 62 bytes each, so ~64 KiB, and this
# is that doubled for the envelope and headroom.
#
# It was 4096 while a duty answered about ONE document. A cap that cannot hold
# what the contract above it may legitimately ask about is not containment, it is
# a lane that refuses valid work.
max_frame_bytes = 131072

# L0's complete transfer outcome vocabulary, as today's `WorkReport` carries it.
# Restated at the binding boundary on purpose: the projection's exhaustive match
# is what pins it to the domain enum, so a variant added there and not here
# fails to compile rather than silently narrowing what an executor may answer.
[[decl]]
kind = "enum"
name = "OutcomeCodeView"
variants = [
  "completed",
  "cancelled",
  "paused",
  "peer_lost",
  "timeout",
  "unauthenticated",
  "version_mismatch",
  "storage_fault",
  "publish_failed",
  "source_unreadable",
  "network_unreachable",
  "internal",
]

# Free-form notice text does not cross this lane. The executor picks
# platform-local copy from this closed class, so a notification can never
# become a channel for arbitrary strings.
[[decl]]
kind = "enum"
name = "NoticeView"
variants = ["transfer_complete", "transfer_failed", "action_needed"]

# Replaces `Lock { hold: bool }`. A boolean is the one shape a permissive JSON
# reader turns into a silent default — `optBoolean("hold")` answers `false` for
# a missing OR mistyped value, so a lane glitch reads as "release the lock".
# Two named directives have no default to fall into.
[[decl]]
kind = "enum"
name = "LockDirectiveView"
variants = ["hold", "release"]

# Wire projection of `DutyProvenance`. Fixed lowercase hex keeps the identifiers
# exact without exposing any language's integer width; `generation` is the
# `AttemptGen` u32 domain. The executor derives its publication recovery key
# from these three fields, which is why they travel together on every kind.
[[decl]]
kind = "struct"
name = "DutyProvenanceView"
fields = [
  { name = "card", type = "hex16" },
  { name = "generation", type = "u32" },
  { name = "request", type = "hex32" },
]

# Payload of the publication duty.
#
# `display_name` is NOT sealed, deliberately, and this is a divergence from the
# design this schema was written from. It is the same value `CardView.offered_name`
# already publishes in the clear on the read contract, and one value that is
# secret on one contract and plain on another teaches nobody anything. In this
# codebase `secret` has meant pairing-password material — the room code, the
# invite link, the QR modules, scanned invite text — and a file name is not
# that. `staged` follows it for the same reason: it is an app-private relative
# name, not a credential.
[[decl]]
kind = "struct"
name = "PublicationWorkView"
fields = [
  { name = "staged", type = "str(512)" },
  # `OfferedName::MAX_BYTES`. The leaf a publication lands under is the
  # authority's sanitized name, not the wider untrusted provider intake bound.
  { name = "display_name", type = "str(255)" },
  # u63 rather than u64: every native target represents this as a non-negative
  # signed 64-bit value, and the read and command contracts already use that
  # horizon. The projection refuses a legacy value above it rather than emitting
  # one the executor cannot represent.
  { name = "total_bytes", type = "u63" },
]

[[decl]]
kind = "struct"
name = "ForegroundWorkView"
fields = [{ name = "active_transfers", type = "u32" }]

# A named payload keeps the notice as the exact value at the `notice` key: on
# the wire this is `"notice":"transfer_complete"`, never an object. That is the
# precise shape the two hand-written codecs disagreed about.
[[decl]]
kind = "struct"
name = "NotificationWorkView"
fields = [{ name = "notice", type = "NoticeView" }]

[[decl]]
kind = "struct"
name = "LockWorkView"
fields = [{ name = "directive", type = "LockDirectiveView" }]

# Every shape today's `Work` enum can carry. The union arm IS the duty kind, so
# there is no second `kind` field that can disagree with its payload — which the
# hand-written version had to check for by hand.
#
# Nine arms, not the six the executor claims nor the two the authority currently
# emits, because a schema is a versioned VOCABULARY rather than a snapshot of
# this week's dispatch. `grant`, `staging` and `open_share` are honest unit
# variants because that is exactly their shape today; giving one a payload later
# is a version bump, not an unversioned reinterpretation of old bytes.
[[decl]]
kind = "union"
name = "WorkView"
variants = [
  { name = "source_handle" },
  { name = "grant" },
  { name = "staging" },
  { name = "publication", payload = "PublicationWorkView" },
  { name = "courier" },
  { name = "foreground", payload = "ForegroundWorkView" },
  { name = "notification", payload = "NotificationWorkView" },
  { name = "lock", payload = "LockWorkView" },
  { name = "open_share" },
]

# One authority-issued order. Provenance sits outside `WorkView` because it
# correlates every kind uniformly.
[[decl]]
kind = "struct"
name = "DutyOrderView"
fields = [
  { name = "provenance", type = "DutyProvenanceView" },
  { name = "work", type = "WorkView" },
]

# How long the PLATFORM's hold on a document lasts, exactly as it reports it.
#
# Never rewritten by anything downstream. Promoting `process` to `persisted`
# once bytes were copied would quietly change the meaning of an admitted result,
# so an exact replay of the original answer would look like a conflict with
# state that had moved underneath it.
[[decl]]
kind = "enum"
name = "SourceRetentionView"
variants = ["process", "persisted"]

# Whether the provider will serve the same bytes again from an offset.
#
# INDEPENDENT of retention, and carried separately for the reason the
# retention/backing split exists: a grant that survives a restart says nothing
# about whether the stream rewinds, and a source that rewinds says nothing about
# whether the grant outlives the process. These two facts together are what
# decide whether a send streams from the provider or must copy first, and a
# single word for both is what made an earlier model unable to explain its own
# restore behaviour.
[[decl]]
kind = "enum"
name = "SourceSeekabilityView"
variants = ["seekable", "sequential_only"]

# What the platform promises about ONE item of the selection.
#
# Per item, never aggregated. Recovery is decided per document: a selection whose
# first file is a persisted seekable provider and whose second is a
# process-lifetime stream can resume the first and not the second, and one pair
# of words for the whole selection cannot say that. An aggregate is derivable
# from these — "all persisted" is a fold — while the per-item answers are not
# derivable from an aggregate, which is why the answers are what cross.
#
# The item is named by its ORDINAL in the accepted selection, which is the same
# ordinal the authority minted. An adapter answering out of order, or for an item
# that is not in the selection, is answering about a document nobody asked about.
[[decl]]
kind = "struct"
name = "AcquiredItemView"
fields = [
  { name = "item", type = "u32" },
  { name = "retention", type = "SourceRetentionView" },
  { name = "seekability", type = "SourceSeekabilityView" },
]

# The whole selection, held.
#
# ALL OF IT OR NONE. There is no per-item failure arm, deliberately: a person
# chose a set, and sending a subset of what they chose — silently — is worse than
# not sending. So one unreadable document fails the acquisition, and the failure
# is the report's own `failed` arm rather than a hole in this list.
#
# The bound matches the offer's, because this answers that offer.
[[decl]]
kind = "struct"
name = "SourceAcquiredView"
fields = [{ name = "items", type = "list(AcquiredItemView, 1024)" }]

# Why an acquisition failed, in the vocabulary the PLATFORM can speak.
#
# Deliberately smaller than the product's prompt reasons. An acquisition cannot
# answer `initial` — it was asked — and it cannot answer `staging_failed`,
# because staging had not started. Both are product conclusions, and leaving
# them unrepresentable here is what stops an adapter authoring one.
[[decl]]
kind = "enum"
name = "SourceFailureView"
variants = ["unreadable", "permission_lost", "storage_fault", "internal"]

[[decl]]
kind = "struct"
name = "SourceFailedView"
fields = [{ name = "reason", type = "SourceFailureView" }]

# What a `source_handle` duty answers, and the reason this contract has a
# version 2.
#
# An `OutcomeCodeView` cannot carry this. `completed` says the platform did
# something; it does not say whether the hold survives a restart or whether the
# source can be re-read from an offset — and those are exactly the two facts
# that decide whether the send streams or copies. A source duty that answered
# only an outcome forced the product to invent the missing ones, and every value
# it could invent is wrong for some real provider.
[[decl]]
kind = "union"
name = "SourceReportView"
variants = [
  { name = "acquired", payload = "SourceAcquiredView" },
  { name = "failed", payload = "SourceFailedView" },
]

# What a duty answered, in the vocabulary its own kind can speak.
#
# Source acquisition is the one kind whose answer is not an outcome code. Every
# other kind answers an outcome and nothing more. The pairing is enforced where
# the result is admitted, so a matched kind and answer is a fact downstream code
# may rely on rather than re-check — and BOTH directions are refusals: a source
# duty answering a bare outcome is the missing-facts defect, and a notification
# answering `source_acquired` is an adapter reporting on work it never did.
[[decl]]
kind = "union"
name = "DutyAnswerView"
variants = [
  { name = "outcome", payload = "OutcomeCodeView" },
  { name = "source", payload = "SourceReportView" },
]

# The executor's entire answer: no handle, no path. Its provenance is still
# untrusted — the ledger admits it, or does not.
[[decl]]
kind = "struct"
name = "DutyReportView"
fields = [
  { name = "provenance", type = "DutyProvenanceView" },
  { name = "answer", type = "DutyAnswerView" },
]

[[decl]]
kind = "union"
name = "DutyBody"
variants = [
  # Unmarked: a host-originated order. Native artifacts decode it and get no
  # encoder for it or for anything reachable only through `WorkView`.
  { name = "order", payload = "DutyOrderView" },
  # The platform executor is the native originator, and this is the only thing
  # it may build.
  { name = "report", payload = "DutyReportView", originator = "frontend" },
]

[[decl]]
kind = "struct"
name = "DutyFrame"
fields = [
  { name = "schema", type = "ascii(64)" },
  { name = "body", type = "DutyBody" },
]
