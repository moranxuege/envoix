/target/

# large payloads
*.mp4
*.mkv

dist/
node_modules/
__pycache__/
*.py[cod]

.DS_Store

# Apple app: generated project + build output + packaged artifacts
/apps/envoix-apple/*.xcodeproj
/apps/envoix-apple/build*/
/apps/envoix-apple/*.zip

# cargo-swift generated Swift package (binary xcframework)
/crates/envoix-ffi/EnvoixCore/
# cargo-swift owns all generated bindings; Rust declarations are the source of truth.
/crates/envoix-ffi/generated/envoix_ffi.swift
/crates/envoix-ffi/generated/envoix_ffiFFI.h
/crates/envoix-ffi/generated/envoix_ffiFFI.modulemap
/crates/envoix-ffi/generated/headers/
/crates/envoix-ffi/generated/sources/

# android
android/local.properties
android/.gradle/
android/.gradle-cache/
android/build/
android/app/build/
.idea/
*.iml
# native libs are built by cargo-ndk (see .github/workflows/release.yml); not tracked
android/app/src/main/jniLibs/
android/.kotlin/

# local design docs
/docs/design/wifi-aware-vertical-slice.md
/docs/issues/issue-reconciliation-plan-2026-07-20.md
/docs/debate.md
/docs/manifest_plan.md
/docs/manifest_goal.md
