/target/
/target-*/
/legacy/target/
/legacy/android/.gradle/
/legacy/android/.kotlin/
/legacy/android/**/build/
/legacy/android/app/src/main/jniLibs/
/legacy/android/local.properties

# large payloads
*.mp4
*.mkv

dist/
node_modules/

.DS_Store

# Apple app: generated project + build output + packaged artifacts
/apps/envoix-apple/*.xcodeproj
/apps/envoix-apple/build*/
/apps/envoix-apple/*.zip

# cargo-swift generated Swift package (binary xcframework)
/crates/envoix-ffi/EnvoixCore/

# android
android/local.properties
android/.gradle/
android/build/
android/app/build/
.idea/
*.iml
# native libs are built by cargo-ndk (see .github/workflows/release.yml); not tracked
android/app/src/main/jniLibs/*/libenvoix_jni.so
android/.kotlin/

# Release signing material — never commit (repo is PUBLIC)
*.jks
*.keystore
keystore.properties
signing.properties

# The flat release policy the packaging side reads. A build artifact, rendered
# from registry/release-ledger.toml by `xtask record-payload`; keeping it out of
# the tree also keeps the release signer fingerprint in exactly one tracked file.
registry/release-policy.properties
