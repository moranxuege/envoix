<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The `scan_invite` capability. Requested at runtime and refusable: a
         refusal is an ANSWER the frontend draws, never a crash, and paste
         remains the way in. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Scanning is a capability, not a requirement: a device with no camera
         installs Envoix and is told, in words, to paste instead. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="Envoix">

        <!-- The observer. It attaches to whatever the service is already
             running and detaches by dying; `configChanges` is the Flutter
             template's list, so a rotation never recreates it.

             A LAUNCHER activity has to be exported, so the launch mode is what
             bounds it: `singleInstance` means the system holds at most one
             instance, alone in its task, however it is started. One instance is
             one engine, one lane and one consumer of a destructive queue —
             which is the state the frame lane can actually reason about. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleInstance"
            android:theme="@style/LaunchTheme"
            android:windowSoftInputMode="adjustResize">
            <!-- Swapped for the running theme once Flutter's first frame is up,
                 which is the template's own handoff. Both are NoTitleBar; the
                 platform must never draw a bar above the one Flutter draws. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The invite scanner. Not exported: it is this app's own capability
             adapter, launched only by MainActivity, and nothing outside the app
             may start a camera on its behalf. -->
        <activity
            android:name=".ScanActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:exported="false"
            android:label="Scan an invite" />

        <!-- The embedding version the Flutter engine looks for. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- The process-lifetime owner: transfers live and die with this
             service, never with a UI attachment (Pillar 7). -->
        <service
            android:name=".EnvoixHostService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
