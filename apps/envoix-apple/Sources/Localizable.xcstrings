      }
    },
    "transfer.failure.rate_limited.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Too many Room attempts. Wait before retrying." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "房间尝试次数过多。请稍后再试。" } }
      }
    },
    "transfer.failure.receiver_destination_unavailable.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose an available destination." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请选择可用的目标位置。" } }
      }
    },
    "transfer.failure.receiver_finalization_unknown.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The receiver cannot yet confirm the final save after an interruption. Resume to reconcile the destination." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "中断后接收端暂时无法确认最终保存结果，请恢复传输以核对目标位置。" } }
      }
    },
    "transfer.failure.receiver_reused_object_lost.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "An existing destination item selected for reuse changed or disappeared. Restore it and resume, or start a new transfer." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "接收端原定复用的已有项目已更改或消失。请恢复该项目后继续，或重新发起传输。" } }
      }
    },
    "transfer.failure.receiver_save_failed.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The receiver could not finish saving. Resume to reconcile it." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "接收端未能完成保存，请恢复以进行确认。" } }
      }
    },
    "transfer.failure.receiver_space_insufficient.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The destination does not have enough space." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目标位置空间不足。" } }
      }
    },
    "transfer.failure.room_expired.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This Room expired. Create a new Room Code." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此房间已过期。请创建新的房间码。" } }
      }
    },
    "transfer.failure.room_full.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This Room is already in use. Retry shortly." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此房间正在使用中。请稍后重试。" } }
      }
