        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "传输失败。" } }
      }
    },
    "transfer.failure.network_lost.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Connection lost. Resume to continue." } },
