    "settings.cache.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Temporary Share and receive data. Active, paused, and resumable transfers are always protected." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于分享和接收的临时数据；活动中、已暂停和可续传的任务始终会被保护。" } }
      }
    },
    "settings.cache.protected" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Protected: %@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "受保护：%@" } }
      }
    },
    "settings.cache.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Transfer cache" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "传输缓存" } }
      }
    },
    "settings.compression.always" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Always" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "始终" } }
      }
    },
    "settings.compression.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Smart uses a conservative, case-insensitive final file-extension list. It does not read a sample or probe the network. “Never” keeps the original bytes; “Always” applies Zstandard. The selected policy is fixed when a new transfer job is created." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "智能模式仅按大小写不敏感的最终文件后缀白名单判断，不读取样本，也不探测网络。从不模式发送原始字节；始终模式应用 Zstandard。新建传输任务时会固定当前策略。" } }
      }
    },
    "settings.compression.never" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Never" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "从不" } }
      }
    },
    "settings.compression.smart" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Smart" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "智能" } }
      }
    },
    "settings.compression.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Compression" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "压缩" } }
      }
    },
